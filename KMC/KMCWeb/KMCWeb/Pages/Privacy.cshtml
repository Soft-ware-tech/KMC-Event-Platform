@page
@model KMCWeb.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="kmc-section" style="max-width:760px;">
    <p class="kmc-eyebrow">Privacy</p>
    <h1>Privacy Policy</h1>
    <div class="kmc-card" style="padding:2rem; margin-top:1rem;">
        <p>The Kandy Municipal Council (KMC) Events platform collects only the information needed to process an event registration: participant name, email, phone number and, for ticketed events, a card holder name and the last four digits of the card used.</p>
        <p>Full card numbers and CVV codes are never stored — they are used only for a moment to simulate payment approval and are then discarded. This information is used solely to manage bookings and is not shared with third parties.</p>
        <p>This page is a placeholder for a student/demo project and does not represent an official KMC policy.</p>
    </div>
</section>
