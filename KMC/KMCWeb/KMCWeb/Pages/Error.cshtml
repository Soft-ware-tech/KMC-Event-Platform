@page
@model KMCWeb.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="kmc-section" style="max-width:640px; text-align:center;">
    <div class="kmc-card" style="padding:2.5rem;">
        <p class="kmc-eyebrow" style="color:var(--kmc-danger);">Error</p>
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="kmc-btn kmc-btn-gradient" asp-page="/Index" style="margin-top:1rem;">Back to Home</a>
    </div>
</section>
