@{
    var organizerId = Context.Session.GetInt32("OrganizerId");
    var organizerName = Context.Session.GetString("OrganizerName");
    var isLoggedIn = organizerId.HasValue;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Kandy Municipal Council Events</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,600&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="kmc-glow kmc-glow-blue"></div>
    <div class="kmc-glow kmc-glow-pink"></div>

    <header class="kmc-nav">
        <div class="kmc-nav-inner">
            <a class="kmc-brand" asp-page="/Index">
                <span class="kmc-brand-mark">KMC</span>
                <span class="kmc-brand-text">Kandy&nbsp;Events</span>
            </a>

            <button class="kmc-nav-toggle" type="button" aria-label="Toggle navigation" onclick="document.querySelector('.kmc-nav-links').classList.toggle('open')">
                <span></span><span></span><span></span>
            </button>

            <nav class="kmc-nav-links">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Events">Explore Events</a>
                <a asp-page="/ManagerLogin">Manager</a>
                @if (isLoggedIn)
                {
                    <a asp-page="/BO/Dashboard">My Dashboard</a>
                    <span class="kmc-nav-user">Hi, @organizerName</span>
                    <a class="kmc-btn kmc-btn-ghost" asp-page="/Logout">Log out</a>
                }
                else
                {
                    <a asp-page="/Login">Organizer Login</a>
                    <a class="kmc-btn kmc-btn-gradient" asp-page="/Register">List Your Event</a>
                }
            </nav>
        </div>
    </header>

    <main class="kmc-main">
        @RenderBody()
    </main>

    <footer class="kmc-footer">
        <div class="kmc-footer-inner">
            <div>
                <span class="kmc-brand-mark small">KMC</span>
                <p>Kandy Municipal Council &middot; City Events Platform</p>
            </div>
            <p class="kmc-footer-copy">&copy; @DateTime.Now.Year Kandy Municipal Council. Built for the community, powered by SOC.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
